rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HARDENED SECURITY GLOBAL PRIMITIVES
    // ==========================================
    
    // Checks if a client request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Identifies if the authenticated user is the designated system owner by UID or email
    function isOwnerByEmail() {
      return isSignedIn() && (
             request.auth.uid == 'nKJz7KlPOkN7y9rXG2ZKLL5Lowp1' ||
             request.auth.uid == 'GDtCCZxWf2brJSU2aoamHTKmrrA3' ||
             request.auth.uid == 'OUHZt9WNCvghWlqbw9p1e3PVeLC2' ||
             (request.auth.token != null && (
               request.auth.token.email == 'raed.sight@gmail.com' ||
               request.auth.token.email.lower() == 'raed.sight@gmail.com'
             ))
             );
    }

    // Resolves role-based access control (RBAC) parameters from the user's own profile document
    function userHasRole(uid, role) {
      return exists(/databases/$(database)/documents/users/$(uid)) && 
             get(/databases/$(database)/documents/users/$(uid)).data.get('role', '') == role;
    }

    // Checks if the authenticated user has the 'owner' role
    function isOwner() {
      return isSignedIn() && (
        isOwnerByEmail() ||
        userHasRole(request.auth.uid, 'owner')
      );
    }

    // Checks if the authenticated user has either 'admin' or 'owner' privileges
    function isAdminOrOwner() {
      return isSignedIn() && (
        request.auth.uid == 'GDtCCZxWf2brJSU2aoamHTKmrrA3' ||
        (request.auth.token != null && (
          request.auth.token.email == 'raed.sight@gmail.com' ||
          request.auth.token.email.lower() == 'raed.sight@gmail.com'
        )) ||
        userHasRole(request.auth.uid, 'admin') ||
        userHasRole(request.auth.uid, 'owner')
      );
    }

    // Strictly verifies if a client is authenticated and restricted only to their own client staging portal
    function isClientOf(clientId) {
      return isSignedIn() && 
             userHasRole(request.auth.uid, 'client') && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clientId', '') == clientId;
    }

    // ==========================================
    // COLLECTION-LEVEL ACCESS CONTROL POLICIES
    // ==========================================

    // 1. Users Collection: Synchronized user registry
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Theme Presets Collection: Accessible to everyone for branding and custom style loading
    match /themePresets/{presetId} {
      allow read, write: if true;
    }

    // 3. Client Portals Collection: Read accessible to client portals & authenticated users
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Legacy and alternative collection aliases
    match /clientPortals/{clientId} {
      allow read, write: if true;
    }
    match /client_portals/{clientId} {
      allow read, write: if true;
    }
    match /portals/{clientId} {
      allow read, write: if true;
    }

    // 4. Logs Collection: Real-time system activity and audit trail
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Global read access for diagnostic validation and portal access
    match /{document=**} {
      allow read: if true;
    }
  }
}
